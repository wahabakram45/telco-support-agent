# Copy to .env (gitignored). Fill prices from the OFFICIAL page: https://openai.com/api/pricing
OPENAI_API_KEY=sk-...
LLM_MODEL=fill-in-cheapest-current-mini-model
# USD per 1M tokens
PRICE_INPUT_PER_M=0.0
PRICE_CACHED_INPUT_PER_M=0.0
PRICE_OUTPUT_PER_M=0.0
EMBEDDING_MODEL=text-embedding-3-small
PRICE_EMBEDDING_PER_M=0.0

# LLM judge for the generation evals (lesson 06). Leave JUDGE_MODEL empty to use LLM_MODEL.
# A stronger judge than the generator is better; fill in its prices if you set one.
JUDGE_MODEL=
PRICE_JUDGE_INPUT_PER_M=0
PRICE_JUDGE_CACHED_INPUT_PER_M=0
PRICE_JUDGE_OUTPUT_PER_M=0
